<% layout('/layouts/boilerplate') -%>

<div class="row mt-3">
    <div class="col-6 offset-3">
        <br /><br />
        <h3>Sign Up</h3>
        <form method="POST" action="/signup" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="username" class="form-label">Username:</label>
                <input name="user[username]" placeholder="enter username" id="username" type="text" class="form-control" required />
                <div class="valid-feedback">Looks good!</div>
            </div>

            <div class="mb-3">
                <label for="email" class="form-label">Email:</label>
                <input name="user[email]" placeholder="enter email" id="email" type="email" class="form-control" required />
                <div class="invalid-feedback">please enter a valid email</div>
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Password:</label>
                <input name="user[password]" placeholder="enter password" id="password" type="password" class="form-control" required />
                <div class="invalid-feedback">please enter a valid password</div>
            </div>

            <button type="submit" class="btn btn-primary">Sign Up</button>
        </form>
    </div>
</div>